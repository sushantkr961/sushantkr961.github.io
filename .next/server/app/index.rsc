,["$","a","a-2",{"href":"#platform","children":"Masai School"}],", an online platform, to sharpen my coding skills and dive deep into ",["$","a","a-3",{"href":"#skills","children":"full-stack development"}],". By early 2023, I landed my first role as a ",["$","a","a-4",{"href":"#designation","children":"Software Developer at Pantheon Digital"}]," while also working as a ",["$","a","a-5",{"href":"#freelancer","children":"freelancer"}],", turning my passion into a profession."]}]}]}]]}],["$","section",null,{"id":"work","children":["$","div",null,{"className":"flex min-h-0 flex-col gap-y-3","children":[["$","$L3",null,{"delay":0.2,"children":["$","h2",null,{"className":"text-xl font-bold","children":"Work Experience"}]}],[["$","$L3","Loading Walla Ventures Pvt. Ltd.",{"delay":0.24,"children":["$","$L7","Loading Walla Ventures Pvt. Ltd.",{"logoUrl":"/loadingwalla.png","altText":"Loading Walla Ventures Pvt. Ltd.","title":"Loading Walla Ventures Pvt. Ltd.","subtitle":"Software Developer (Team Lead)","href":"https://loadingwalla.com/","badges":[],"period":"Oct 2024 - present","description":"Developed LoadingWalla’s website using Next.js, TypeScript, and Node.js, ensuring a scalable and high-performance web experience. Additionally, I built the Android app using React Native, delivering a smooth and efficient mobile experience. To streamline internal operations, I also engineered the CRM platform using Next.js, optimizing user management and business workflows."}]}],["$","$L3","Pantheon Digital Pvt. Ltd.",{"delay":0.29,"children":["$","$L7","Pantheon Digital Pvt. Ltd.",{"logoUrl":"/pantheon.jpg","altText":"Pantheon Digital Pvt. Ltd.","title":"Pantheon Digital Pvt. Ltd.","subtitle":"Software Developer","href":"https://pantheondigitals.com","badges":[],"period":"April 2023 - Sep 2024","description":"Developed and maintained Pantheon Digital’s website, HR portal, and CRM software to streamline internal operations. Implemented secure authentication with login/signup functionality, built asset management and attendance tracking features for the HR portal, and enhanced the CRM by developing a ticketing system to improve customer support efficiency."}]}]]]}]}],["$","section",null,{"id":"certification","children":["$","div",null,{"className":"flex min-h-0 flex-col gap-y-3","children":[["$","$L3",null,{"delay":0.28,"children":["$","h2",null,{"className":"text-xl font-bold","children":"Certifications"}]}],[["$","$L3","Masai School",{"delay":0.32,"children":["$","$L7","Masai School",{"href":"https://www.masaischool.com","logoUrl":"/masai.png","altText":"Masai School","title":"Masai School","subtitle":"Full Stack Web Development Program","period":"Sep 2022 - Feb 2023"}]}]]]}]}],["$","section",null,{"id":"education","children":["$","div",null,{"className":"flex min-h-0 flex-col gap-y-3","children":[["$","$L3",null,{"delay":0.28,"children":["$","h2",null,{"className":"text-xl font-bold","children":"Education"}]}],[["$","$L3","Aryabhatta Knowledge University",{"delay":0.32,"children":["$","$L7","Aryabhatta Knowledge University",{"href":"https://akubihar.ac.in","logoUrl":"/aku.jpeg","altText":"Aryabhatta Knowledge University","title":"Aryabhatta Knowledge University","subtitle":"Bachelor's Degree in Mechanical Engineering","period":"2016 - 2020"}]}],["$","$L3","Central Board of Secondary Education",{"delay":0.37,"children":["$","$L7","Central Board of Secondary Education",{"href":"https://kpsbihta.in","logoUrl":"/cbse.png","altText":"Central Board of Secondary Education","title":"Central Board of Secondary Education","subtitle":"Senior secondary","period":"2014 - 2016"}]}]]]}]}],["$","section",null,{"id":"skills","children":["$","div",null,{"className":"flex min-h-0 flex-col gap-y-3","children":[["$","$L3",null,{"delay":0.36,"children":["$","h2",null,{"className":"text-xl font-bold","children":"Skills"}]}],["$","div",null,{"className":"flex flex-wrap gap-1","children":[["$","$L3","React",{"delay":0.4,"children":["$","div",null,{"className":"inline-fl